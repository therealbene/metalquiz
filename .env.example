# Album data source:
#   mock     (default) generated placeholder covers, no setup
#   catalog  prebuilt public/albums.json (create it with `npm run catalog`). Recommended for production.
#   discogs  live Discogs through the proxy, samples random search pages per session
VITE_ALBUM_SOURCE=mock

# Discogs through the built-in proxy (recommended, also for local development).
# The browser only talks to /api/discogs. The token stays on the server.
VITE_DISCOGS_BASE_URL=/api/discogs
# Server-side only. No VITE_ prefix, so it is never bundled into the site.
# Personal access token from https://www.discogs.com/settings/developers
# In production set this in your host's environment variables (Vercel: Project Settings > Environment Variables).
DISCOGS_TOKEN=
